SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
DATABASE_URL=postgresql://postgres:password@localhost:5432/flowforge
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8001/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=
WEBHOOK_CALLBACK_URL=
# Optional. Core repository features work without AI credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=60
MAX_LOG_BYTES=20000000
